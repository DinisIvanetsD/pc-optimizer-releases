<Window x:Class="PCOptimizer.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bem-vindo ao Rigwise" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterOwner" Icon="/app.ico">
  <StackPanel x:Name="Root" Margin="28,24,28,22">
    <StackPanel Orientation="Horizontal">
      <Image Source="/logo.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="Bem-vindo ao Rigwise" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Deixa o teu PC mais rápido, estável e limpo — sem riscos." Style="{StaticResource Muted}"/>
      </StackPanel>
    </StackPanel>

    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
      <StackPanel>
        <DockPanel Margin="0,0,0,12">
          <TextBlock Text="🔍" FontSize="20" Width="36" VerticalAlignment="Top"/>
          <StackPanel>
            <TextBlock Text="Primeiro, ela analisa" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Muted}" Text="Ecrãs azuis, RAM, discos, drivers, rede. Na página Início vês o que está mal e o que fazer primeiro."/>
          </StackPanel>
        </DockPanel>
        <DockPanel Margin="0,0,0,12">
          <TextBlock Text="↶" FontSize="20" Width="36" VerticalAlignment="Top"/>
          <StackPanel>
            <TextBlock Text="Tudo se desfaz" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Muted}" Text="Cada alteração fica no Histórico com um botão para desfazer. Nada é apagado sem confirmações (e vai para a Reciclagem)."/>
          </StackPanel>
        </DockPanel>
        <DockPanel>
          <TextBlock Text="🛡" FontSize="20" Width="36" VerticalAlignment="Top"/>
          <StackPanel>
            <TextBlock Text="Administrador só quando é preciso" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Muted}" Text="Para ver, chega o modo normal. Para aplicar ajustes, instalar drivers ou ler os relatórios de crash, a app pede para abrir como administrador."/>
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <CheckBox x:Name="StartupCheck" Margin="2,16,0,0" Content="Arrancar com o Windows e vigiar o PC em segundo plano"/>

    <DockPanel Margin="0,22,0,0">
      <Button DockPanel.Dock="Right" Content="Começar  →" Click="Start_Click" Style="{StaticResource PrimaryButton}" Margin="0" IsDefault="True" Padding="22,9"/>
      <TextBlock Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                 Text="Dica: Ctrl+1…9 muda de página, F5 atualiza a página aberta."/>
    </DockPanel>
  </StackPanel>
</Window>
