<Window x:Class="PCOptimizer.App.GameOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rigwise overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Focusable="False">
  <Border x:Name="Box" Background="#B0101318" CornerRadius="8" Padding="10,5" BorderThickness="1" BorderBrush="Transparent">
    <StackPanel Orientation="Horizontal">
      <Ellipse x:Name="Dot" Width="9" Height="9" Fill="#7C8799" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock x:Name="Text" Text="A medir…" Foreground="White" FontSize="13" FontFamily="Segoe UI Semibold" VerticalAlignment="Center"/>
      <TextBlock x:Name="MoveHint" Text="  ⤧ arrasta e carrega em Enter" Foreground="#9AA4B2" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed"/>
    </StackPanel>
  </Border>
</Window>
